<Window x:Class="TecmoScoreGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tecmo Score Grabber" Height="640" Width="920"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock x:Name="PhaseText" FontSize="16" FontWeight="SemiBold" Text="Phase: —"/>
            <TextBlock x:Name="SubStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Text="Status: —"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="CountersText" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Capture monitor:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="MonitorCombo" Width="480" DisplayMemberPath="DisplayName"
                      SelectionChanged="MonitorCombo_OnSelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,8">
            <TextBlock x:Name="ApiPingText" Text="Last API success (UTC): —"/>
            <TextBlock x:Name="LastSaveText" Margin="0,4,0,0" TextWrapping="Wrap" Text="Last save: —"/>
            <TextBlock x:Name="ConfigSnapshotText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#444"/>
        </StackPanel>

        <TabControl Grid.Row="4" BorderBrush="#CCC" BorderThickness="1">
            <TabItem Header="Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl x:Name="LogItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,2" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Header}"/>
                                    </Expander.Header>
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Last capture">
                <ScrollViewer Padding="4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Image x:Name="LastCaptureImage"
                           MaxWidth="500"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Vision input (grayscale)">
                <DockPanel Margin="4" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" x:Name="VisionInputDimsText" Margin="0,0,0,6" Foreground="#444" FontSize="11" TextWrapping="Wrap" Text="—"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Image x:Name="VisionInputImage"
                               MaxWidth="500"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CaptureNowBtn" Content="Capture now" Width="110" Margin="0,0,8,0" Click="CaptureNow_OnClick"/>
            <Button x:Name="PauseBtn" Content="Pause" Width="90" Margin="0,0,8,0" Click="PauseBtn_OnClick"/>
            <Button Content="Export log…" Width="100" Margin="0,0,8,0" Click="ExportLog_OnClick"/>
            <Button Content="Open debug folder" Width="130" Margin="0,0,8,0" Click="OpenDebug_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
