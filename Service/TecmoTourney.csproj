<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="13.0.1" />
		<PackageReference Include="Dapper" Version="2.1.35" />
		<PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.3.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="OpenAI" Version="2.1.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
	</ItemGroup>
	<ItemGroup>
		<!-- Exclude all files in the GeneratedCode directory -->
		<Compile Remove="**\GeneratedCode\**\*.cs" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="gptFiles\pointspread.instructions.txt" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="gptFiles\pointspread.instructions.txt">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="wwwroot\" />
	</ItemGroup>

	<!-- Set BuildSpasOnPublish=false to skip npm/ng when publishing API-only (requires Node.js + npm on PATH). -->
	<PropertyGroup>
		<BuildSpasOnPublish Condition="'$(BuildSpasOnPublish)' == ''">true</BuildSpasOnPublish>
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</RepoRoot>
		<WagerClientDir>$(RepoRoot)\Client\tecmo-wager</WagerClientDir>
		<TourneyClientDir>$(RepoRoot)\Client\tecmo-tourney</TourneyClientDir>
		<WagerBrowserOut>$(WagerClientDir)\dist\tecmo-wager\browser</WagerBrowserOut>
		<TourneyBrowserOut>$(TourneyClientDir)\dist\tecmo-tourney\browser</TourneyBrowserOut>
	</PropertyGroup>

	<Target Name="BuildAndCopySpasToWwwroot"
	        BeforeTargets="ComputeFilesToPublish"
	        Condition="'$(BuildSpasOnPublish)' == 'true' AND '$(DesignTimeBuild)' != 'true'">
		<Message Importance="high" Text="Building Tecmo Wager SPA..." />
		<Exec WorkingDirectory="$(WagerClientDir)" Command="npm ci --no-audit --no-fund" />
		<Exec WorkingDirectory="$(WagerClientDir)" Command="npx ng build --configuration production" />

		<Message Importance="high" Text="Building Tecmo Tourney SPA..." />
		<Exec WorkingDirectory="$(TourneyClientDir)" Command="npm ci --no-audit --no-fund" />
		<Exec WorkingDirectory="$(TourneyClientDir)" Command="npx ng build --configuration production" />

		<RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\wager" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\wager')" />
		<RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\tourney" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\tourney')" />
		<MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\wager" />
		<MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\tourney" />
		<ItemGroup>
			<WagerSpaFiles Include="$(WagerBrowserOut)\**\*.*" />
			<TourneySpaFiles Include="$(TourneyBrowserOut)\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(WagerSpaFiles)"
		      DestinationFiles="@(WagerSpaFiles->'$(MSBuildProjectDirectory)\wwwroot\wager\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="false" />
		<Copy SourceFiles="@(TourneySpaFiles)"
		      DestinationFiles="@(TourneySpaFiles->'$(MSBuildProjectDirectory)\wwwroot\tourney\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="false" />
		<Message Importance="high" Text="SPAs copied to wwwroot\wager and wwwroot\tourney." />
	</Target>

</Project>
